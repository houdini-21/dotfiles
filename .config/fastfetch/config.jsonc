{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/Images/terminal.jpg",
        "type": "kitty",
        "width": 35,
        "height": 15
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "wm",
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7} | Temp: {8}",
            "temp": true
        },
        {
            "type": "gpu",
            "format": "{1} {2} | Temp: {3}",
            "temp": true
        },
        {
            "type": "memory",
            "format": "{1} / {2} ({3})"
        }
    ]
}
