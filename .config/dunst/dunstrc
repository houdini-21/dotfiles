[global]
    monitor = 0
    follow = none
    
    width = 275
    height = (0, 90)
    origin = top-right
    offset = (20, 45)
    
    scale = 0
    notification_limit = 5

    frame_width = 2
    separator_height = 2
    padding = 8
    horizontal_padding = 15
    text_icon_padding = 10
    corner_radius = 10
    frame_color = "#89B4FA"
    separator_color = "frame"

    font = JetBrainsMono Nerd Font 8
    markup = full
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    max_icon_size = 50

[urgency_low]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    frame_color = "#89B4FA"
    timeout = 5

[urgency_normal]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    frame_color = "#89B4FA"
    timeout = 5

[urgency_critical]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    frame_color = "#F38BA8"
    timeout = 0
